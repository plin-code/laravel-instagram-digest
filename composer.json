{
    "name": "plin-code/laravel-instagram-digest",
    "description": "Laravel package that scrapes Instagram hashtags via Apify and sends a daily Telegram digest with inline action buttons.",
    "keywords": [
        "PlinCode",
        "laravel",
        "instagram",
        "apify",
        "telegram",
        "digest",
        "scraping"
    ],
    "homepage": "https://github.com/plin-code/laravel-instagram-digest",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniele Barbaro",
            "email": "barbaro.daniele@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0 || ^13.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PlinCode\\InstagramDigest\\": "src/",
            "PlinCode\\InstagramDigest\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PlinCode\\InstagramDigest\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PlinCode\\InstagramDigest\\InstagramDigestServiceProvider"
            ],
            "aliases": {
                "InstagramDigest": "PlinCode\\InstagramDigest\\Facades\\InstagramDigest"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
